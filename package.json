{
	"name": "refined-saved-replies",
	"version": "0.5.0",
	"description": "Browser extension for GitHub's Saved Replies that adds replies from a repository's .github/replies.yml. 📨",
	"homepage": "https://github.com/JoshuaKGoldberg/refined-saved-replies#readme",
	"bugs": {
		"url": "https://github.com/JoshuaKGoldberg/refined-saved-replies/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/refined-saved-replies.git"
	},
	"license": "MIT",
	"author": {
		"name": "JoshuaKGoldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"main": "lib/index.js",
	"files": [
		"lib/"
	],
	"scripts": {
		"build": "web-ext build --overwrite-dest",
		"dev": "esbuild src/content-script.ts --bundle --minify --outfile=lib/content-script.js --sourcemap",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:knip:production": "knip --production",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"lint:web-ext": "web-ext lint",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc"
	},
	"dependencies": {
		"js-yaml": "^4.1.0",
		"mustache": "^4.2.0"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@types/js-yaml": "4.0.9",
		"@types/mustache": "4.2.5",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"create-typescript-app": "2.87.16",
		"cspell": "10.5.2",
		"esbuild": "0.28.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"happy-dom": "20.13.2",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"knip": "6.47.0",
		"prettier": "3.9.6",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"pretty-quick": "4.2.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.0",
		"web-ext": "10.1.0"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"provenance": true
	}
}
